# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development            # development | testing | production

# PostgreSQL. Use a dedicated least-privilege DB user; add ?sslmode=require for remote DBs.
DATABASE_URL=postgresql+psycopg2://pos_user:CHANGE_ME@localhost:5432/pos_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be >= 32 chars. Changing it logs everybody out.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Login brute-force protection (per username + IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Comma-separated browser origins allowed to call the API. Leave empty for none.
# Example: http://localhost:3000,https://pos.example.com
CORS_ORIGINS=
